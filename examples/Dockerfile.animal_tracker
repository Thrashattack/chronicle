FROM eclipse-temurin:21-jdk

ARG JRUBY_VERSION=10.0.7.0
ENV JRUBY_HOME=/opt/jruby
ENV PATH="${JRUBY_HOME}/bin:${PATH}"

RUN apt-get update \
  && apt-get install --no-install-recommends -y build-essential curl tar \
  && rm -rf /var/lib/apt/lists/* \
  && curl -fsSL "https://repo1.maven.org/maven2/org/jruby/jruby-dist/${JRUBY_VERSION}/jruby-dist-${JRUBY_VERSION}-bin.tar.gz" -o /tmp/jruby.tar.gz \
  && tar -xzf /tmp/jruby.tar.gz -C /opt \
  && mv "/opt/jruby-${JRUBY_VERSION}" "$JRUBY_HOME" \
  && rm /tmp/jruby.tar.gz

WORKDIR /app
COPY . /app
WORKDIR /app/examples/animal_tracker

RUN bundle install

ENV RAILS_ENV=development
EXPOSE 3000
