FROM eclipse-temurin:17-jre

ARG DATOMIC_VERSION=1.0.7705
ENV DATOMIC_HOME=/opt/datomic

RUN apt-get update \
  && apt-get install --no-install-recommends -y curl netcat-openbsd unzip \
  && rm -rf /var/lib/apt/lists/* \
  && curl -fsSL "https://datomic-pro-downloads.s3.amazonaws.com/${DATOMIC_VERSION}/datomic-pro-${DATOMIC_VERSION}.zip" -o /tmp/datomic.zip \
  && unzip -q /tmp/datomic.zip -d /opt \
  && mv "/opt/datomic-pro-${DATOMIC_VERSION}" "$DATOMIC_HOME" \
  && rm /tmp/datomic.zip

COPY datomic/transactor.properties /opt/datomic/config/transactor.properties

VOLUME ["/var/lib/datomic"]
EXPOSE 4334 4335 8001

CMD ["/bin/sh", "-ec", "exec /opt/datomic/bin/transactor /opt/datomic/config/transactor.properties & until nc -z 127.0.0.1 4334; do sleep 2; done; exec /opt/datomic/bin/rest -p 8001 dev datomic:dev://localhost:4334/"]
