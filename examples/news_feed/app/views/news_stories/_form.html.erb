<%= form_with model: news_story, class: 'story-form' do |form| %>
  <% if news_story.errors.any? %>
    <div class="errors"><%= news_story.errors.full_messages.to_sentence %></div>
  <% end %>

  <%= form.label :headline %>
  <%= form.text_field :headline, required: true, autofocus: true %>
  <%= form.label :source %>
  <%= form.text_field :source, required: true %>
  <%= form.label :body %>
  <%= form.text_area :body, rows: 8, required: true %>
  <%= form.submit submit_label, class: 'button button-primary' %>
<% end %>
